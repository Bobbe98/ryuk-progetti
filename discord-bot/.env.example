# === OBBLIGATORI ===
# Token del bot: https://discord.com/developers/applications -> la tua app -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID: General Information -> Application ID
CLIENT_ID=

# === CONSIGLIATO MENTRE SVILUPPI ===
# ID del tuo server: i comandi compaiono subito (globali = fino a 1 ora)
GUILD_ID=

# === AI GRATUITA (basta UNA delle due) ===
# Groq (gratis, velocissimo): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === INTENT PRIVILEGIATI ===
# Attivali anche nel portale: Bot -> Privileged Gateway Intents
# MESSAGE_CONTENT: chat quando menzioni il bot e /riassumi
ENABLE_MESSAGE_CONTENT=true
# SERVER MEMBERS: messaggi di benvenuto e ruolo automatico
ENABLE_MEMBERS=true

# Lingua delle ricerche Wikipedia
WIKI_LANG=it
